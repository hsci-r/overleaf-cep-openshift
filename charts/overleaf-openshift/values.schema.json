{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "positive": {"type": "integer", "minimum": 1},
    "nonnegative": {"type": "integer", "minimum": 0}
  },
  "properties": {
    "compilation": {
      "type": "object",
      "properties": {
        "backend": {"enum": ["local", "kubernetes"]},
        "kubernetes": {
          "type": "object",
          "properties": {
            "requestTimeoutSeconds": {"$ref": "#/definitions/positive"},
            "idleSeconds": {"$ref": "#/definitions/positive"},
            "maxLifetimeSeconds": {"$ref": "#/definitions/positive"},
            "finishedTtlSeconds": {"$ref": "#/definitions/nonnegative"}
          }
        }
      }
    },
    "extraEnv": {
      "type": "object",
      "additionalProperties": {"type": ["string", "boolean", "number"]}
    }
  }
}
