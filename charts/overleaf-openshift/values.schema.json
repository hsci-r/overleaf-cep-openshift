{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "maxLength": 253
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "certificate": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "caCertificate": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "siteUrl": {
      "type": "string",
      "pattern": "^$|^https://[^/]+/?$"
    },
    "appName": {
      "type": "string",
      "minLength": 1
    },
    "adminEmail": {
      "type": "string"
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnv": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "number"
        ]
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Gi|Mi|Ti)$"
        },
        "existingClaim": {
          "type": "string"
        },
        "retain": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 240
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Gi|Mi|Ti)$"
            },
            "existingClaim": {
              "type": "string"
            },
            "retain": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "wiredTigerCacheSizeGB": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        }
      },
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Gi|Mi|Ti)$"
            },
            "existingClaim": {
              "type": "string"
            },
            "retain": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedEmailDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
          }
        }
      },
      "additionalProperties": false
    },
    "compilation": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "requestSizeMB": {
          "type": "integer",
          "minimum": 1
        },
        "defaultCompiler": {
          "enum": [
            "pdflatex",
            "latex",
            "xelatex",
            "lualatex"
          ]
        }
      },
      "additionalProperties": false
    },
    "uploads": {
      "type": "object",
      "properties": {
        "maxSizeMB": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "nginx": {
      "type": "object",
      "properties": {
        "proxyTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "keepaliveTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "workerConnections": {
          "type": "integer",
          "minimum": 1
        },
        "workerProcesses": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "historyRestore": {
          "type": "boolean"
        },
        "pandocConversions": {
          "type": "boolean"
        },
        "chat": {
          "type": "boolean"
        },
        "linkedFilesFromUrl": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sharing": {
      "type": "object",
      "properties": {
        "publicAccess": {
          "type": "boolean"
        },
        "anonymousReadWrite": {
          "type": "boolean"
        },
        "linkSharing": {
          "type": "boolean"
        },
        "restrictInvitesToExistingAccounts": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "templateGallery": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "nonAdminCanPublish": {
          "type": "boolean"
        },
        "managerUserId": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "academic-journal",
              "book",
              "presentation",
              "poster",
              "cv",
              "homework",
              "bibliography",
              "calendar",
              "formal-letter",
              "report",
              "thesis",
              "newsletter"
            ]
          }
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "academic-journal",
              "book",
              "presentation",
              "poster",
              "cv",
              "homework",
              "bibliography",
              "calendar",
              "formal-letter",
              "report",
              "thesis",
              "newsletter",
              "all"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "automaticDeletion": {
          "type": "boolean"
        },
        "deletedUsersDays": {
          "type": "integer",
          "minimum": 1
        },
        "deletedProjectsDays": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "smtp": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secure": {
          "type": "boolean"
        },
        "verifyCertificate": {
          "type": "boolean"
        },
        "ignoreStartTLS": {
          "type": "boolean"
        },
        "sender": {
          "type": "string"
        },
        "replyTo": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ldap",
              "saml",
              "oidc"
            ]
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "patternProperties": {
            "^OVERLEAF_(OIDC|LDAP|SAML)_[A-Z0-9_]+$": {
              "type": [
                "string",
                "boolean",
                "number"
              ]
            }
          },
          "additionalProperties": false,
          "propertyNames": {
            "not": {
              "pattern": "(SECRET|PASSWORD|PASS|PRIVATE_KEY|CREDENTIALS)$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "githubSync": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clientId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "zotero": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clientKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
